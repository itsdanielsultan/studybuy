{
  "rewrites": [
    {"source": "/api/offers", "destination": "/api/index?studybuy_route=offers"},
    {"source": "/api/approve", "destination": "/api/index?studybuy_route=approve"},
    {"source": "/api/retry", "destination": "/api/index?studybuy_route=retry"},
    {"source": "/api/reset", "destination": "/api/index?studybuy_route=reset"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
  ]}]
}
